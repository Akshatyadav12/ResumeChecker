GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- OTP / accounts ---
SECRET_KEY=generate_a_long_random_string
# Development only: prints the OTP in the server console instead of sending it
OTP_DEV_MODE=1
# Email OTP (any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app_password
SMTP_FROM=ResumeChecker <you@example.com>
# SMS OTP (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+10000000000
